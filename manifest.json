{
  "manifest_version": 3,
  "name": "YG Easy",
  "description": "Fast creation of hierarchical YouGile tasks.",
  "version": "0.1.0",
  "action": {
    "default_title": "YG Easy",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": ["storage"],
  "host_permissions": ["https://yougile.com/*"]
}
